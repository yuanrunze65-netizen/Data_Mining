
# pdfLaTeX + BibTeX. TeX Live takes a semicolon-separated search path on Windows.
$pdf_mode = 1;
$pdflatex = 'pdflatex -no-shell-escape %O %S';
my $sep = $^O eq 'MSWin32' ? ';' : ':';
sub course_path {
    my ($key, @dirs) = @_;
    $ENV{$key} = join($sep, @dirs, (defined $ENV{$key} ? $ENV{$key} : ""));
}
course_path('TEXINPUTS', './styles', './fonts');
course_path('BIBINPUTS', './bib');
course_path('BSTINPUTS', './bib');
course_path('TFMFONTS', './fonts');
course_path('VFFONTS', './fonts');
